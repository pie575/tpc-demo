{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "The Prompting Company",
  "colors": {
    "primary": "#007AFF",
    "light": "#5AC8FA",
    "dark": "#0051D5"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "api": {
    "playground": {
      "display": "interactive"
    },
    "examples": {
      "defaults": "required",
      "languages": ["curl", "javascript", "python"],
      "prefill": true
    },
    "url": "full"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@promptingco.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.promptingco.com"
    }
  },
  "footer": {
    "socials": {
      "x": "https://x.com/promptingco",
      "github": "https://github.com/promptingcompany",
      "linkedin": "https://linkedin.com/company/prompting-company"
    }
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude", "perplexity", "mcp", "cursor", "vscode"],
    "display": "header"
  },
  "styling": {
    "latex": false,
    "codeblocks": "system"
  },
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Platform",
          "icon": "globe",
          "href": "https://app.promptingco.com"
        },
        {
          "anchor": "GitHub",
          "icon": "github",
          "href": "https://github.com/promptingcompany"
        }
      ]
    },
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "guides/quickstart-guide",
              "guides/MCP-Server"
            ]
          },
          {
            "group": "Dashboard overview",
            "pages": [
              "guides/knowledge-base",
              "guides/add-prompts",
              "guides/create-content",
              "guides/metrics"
            ]
          },
          {
            "group": "Content publishing",
            "pages": [
              "guides/cms/overview",
              "guides/cms/wordpress",
              "guides/cms/sanity",
              "guides/cms/webflow",
              "guides/cms/ghost",
              "guides/cms/framer",
              "guides/cms/prismic",
              "guides/cms/custom"
            ]
          },
          {
            "group": "Analytics",
            "pages": [
              "guides/analytics/cf-integration",
              {
                "group": "Third-party log exporters",
                "pages": [
                  "guides/analytics/log-exporters/cloudflare-logpush",
                  "guides/analytics/log-exporters/raw-events"
                ]
              },
              "guides/analytics/cf-traffic-export"
            ]
          },
          {
            "group": "Agent experience",
            "pages": [
              "guides/coding-agent-optimization/overview",
              {
                "group": "Core concepts",
                "pages": [
                  "guides/coding-agent-optimization/tasks",
                  "guides/coding-agent-optimization/environments",
                  "guides/coding-agent-optimization/runs",
                  "guides/coding-agent-optimization/experiments",
                  "guides/coding-agent-optimization/signals"
                ]
              },
              "guides/coding-agent-optimization/limits"
            ]
          }
        ]
      },
      {
        "tab": "CLI",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "cli/overview",
              "cli/installation",
              "cli/authentication",
              "cli/organizations"
            ]
          },
          {
            "group": "Commands",
            "pages": [
              "cli/commands/content",
              "cli/commands/knowledge",
              "cli/commands/prompts",
              "cli/commands/persona",
              "cli/commands/llmstxt",
              "cli/commands/analytics",
              "cli/commands/council",
              "cli/commands/simulation-environments",
              "cli/commands/agent-experience"
            ]
          },
          {
            "group": "Recipes",
            "pages": [
              "cli/recipes/competitive-position-by-topic"
            ]
          },
          {
            "group": "Reference",
            "pages": [
              "cli/troubleshooting"
            ]
          }
        ]
      },
      {
        "tab": "API",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "api/overview",
              "api/quickstart",
              "api/authentication"
            ]
          },
          {
            "group": "Concepts",
            "pages": [
              "api/scopes",
              "api/rate-limits",
              "api/idempotency",
              "api/errors",
              "api/audit-log"
            ]
          },
          {
            "group": "Content API",
            "pages": [
              "api/content/overview",
              "api/content/site-pages",
              "api/content/documents"
            ]
          },
          {
            "group": "API Reference",
            "openapi": {
              "source": "/api-reference/openapi.json",
              "directory": "api/reference"
            }
          }
        ]
      },
      {
        "tab": "SDK",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "ts-sdk/index"
            ]
          },
          {
            "group": "TypeScript",
            "pages": [
              "ts-sdk/introduction",
              "ts-sdk/installation",
              "ts-sdk/quickstart",
              "ts-sdk/advanced-usage"
            ]
          }
        ]
      }
    ]
  }
}
